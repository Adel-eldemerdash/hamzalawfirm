{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "regex": "^/services/([a-z0-9]+(?:-[a-z0-9]+)*)$",
        "destination": "/serviceDetails/index.html"
      }
    ]
  }
}
